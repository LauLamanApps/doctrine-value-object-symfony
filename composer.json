{
    "name": "laulamanapps/doctrine-value-object-symfony",
    "description": "Typed value objects and dedicated entity IDs for Doctrine/Symfony, with matching Doctrine types and zero-config auto-registration.",
    "type": "symfony-bundle",
    "keywords": ["symfony", "symfony-bundle", "doctrine", "value-object", "identifier", "ddd", "doctrine-type"],
    "license": "MIT",
    "authors": [
        {
            "name": "Laurens Laman",
            "email": "laurens.laman@llaman.nl"
        }
    ],
    "require": {
        "php": ">=8.4",
        "doctrine/dbal": "^4.0",
        "doctrine/doctrine-bundle": "^2.13 || ^3.0",
        "symfony/config": "^7.1 || ^8.0",
        "symfony/dependency-injection": "^7.1 || ^8.0",
        "symfony/http-kernel": "^7.1 || ^8.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^13.4"
    },
    "autoload": {
        "psr-4": {
            "LauLamanApps\\DoctrineValueObject\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LauLamanApps\\DoctrineValueObject\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
